# ==============================================================================
# Loan Eligibility Prediction System — Environment Variables Configuration
# Copy this file to '.env' for local development.
# In Render, configure these environment variables in the Render Dashboard.
# NEVER commit the actual '.env' file containing real secrets to GitHub!
# ==============================================================================

# Django Secret Key (required in production).
# Generate a new random key: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=your-long-secure-random-secret-key-here-at-least-50-characters

# Debug Mode: Set to 'True' for local dev, 'False' for production.
DJANGO_DEBUG=True

# Allowed Hosts: Comma-separated list of hostnames/domains.
# For Render, add your render service domain (e.g. your-app.onrender.com).
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,.onrender.com

# CSRF Trusted Origins: Comma-separated list of schemes + domains for CSRF validation.
# Required for Render HTTPS domains.
CSRF_TRUSTED_ORIGINS=http://127.0.0.1,http://localhost,https://*.onrender.com

# Database URL:
# For local development with SQLite, leave blank or specify sqlite path:
# DATABASE_URL=sqlite:///db.sqlite3
# For Render PostgreSQL (automatically provided by Render if you link a PostgreSQL database):
# DATABASE_URL=postgres://user:password@hostname:5432/dbname

# Email Backend:
# For local development: django.core.mail.backends.console.EmailBackend
# For production: django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# HTTPS Redirection (Defaults to True when DJANGO_DEBUG=False):
# SECURE_SSL_REDIRECT=True
